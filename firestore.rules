rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only read and write their own profile and workspace.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{sub=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Public demo / contact forms: create-only, size-limited, never readable from the client.
    match /leads/{id} {
      allow create: if request.resource.data.form is string
        && request.resource.data.email is string
        && request.resource.data.email.size() < 200
        && request.resource.data.size() < 15;
      allow read, update, delete: if false;
    }
  }
}
